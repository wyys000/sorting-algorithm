//passing in the current runing thread compare to the thread that will be pass in and check if which is smaller returning true or false
bool checksjf(bucket &a, bucket &b){
    //in other word answering should a process before b process
    if(a.burst < b.burst) return true;
    else return false;
}

//a sorting method for arrive time
// in order for insertion sort to change the position of different task we need to pass in the bucket
void insertionSort(bucket arr[], int size){
    for(int i=1; i < size; i++){
        int j = i-1;
        bucket key = arr[i];
        while(j >= 0){
            if(arr[j].arrive > key.arrive){
            arr[j +1] = arr[j];
            --j;
            }
            else{
                break;
            }
        }
        arr[j+1] = key;
    }
}


